{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "virtual-lab/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|.+.js|.+.css|.+.map|.+.svg|.+.png|.+.jpg|.+.jpeg|.+.gif|.+.webp|.+.ico|.+.pdf|.+.woff|.+.woff2|.+.ttf).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
